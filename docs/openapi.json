{
  "openapi": "3.1.0",
  "info": {
    "title": "OLAP BI Platform API",
    "description": "Tier 3 \u2013 AI-powered Business Intelligence with multi-agent OLAP analysis.\n\n**Swagger UI:** `/docs`  \n**ReDoc:** `/redoc`  \n**OpenAPI JSON spec:** `/openapi.json`\n\nFeatures: natural language queries, slice/dice/pivot, drill-down/roll-up, KPI calculations, reports.",
    "version": "1.0.0"
  },
  "paths": {
    "/": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Root",
        "description": "Service info and links to Swagger/API docs.",
        "operationId": "root__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/query": {
      "post": {
        "tags": [
          "Query"
        ],
        "summary": "Query",
        "description": "Main endpoint: natural-language or structured query; returns full pipeline (cube, KPI, drill, report).",
        "operationId": "query_query_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BIQueryRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BIQueryResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/analytics/query": {
      "post": {
        "tags": [
          "Query"
        ],
        "summary": "Analytics Query",
        "description": "Alias for /query. Same request/response.",
