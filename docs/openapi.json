          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BIQueryResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/report": {
      "post": {
        "tags": [
          "Report"
        ],
        "summary": "Report",
        "description": "Return report-only: executive summary, totals, formatting, formatted table, follow-up suggestions.",
        "operationId": "report_report_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
